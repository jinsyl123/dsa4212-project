# Python / environments
__pycache__/
*.pyc
.venv/
venv/
env/
.ipynb_checkpoints/

# Secrets: API keys live here, never commit
.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Generated instances (rebuilt deterministically from configs/instances/*.yaml)
data/

# Run outputs are committed in full (every evaluated program, LLM4AD logs, per-instance scores),
# so results can be audited. Only the temporary per-candidate folder, deleted at the end of a run, stays out.
results/*/*/seed*/per_instance/

results/smoke/
results/pipecheck*/

# Archives and local copies of libraries
*.zip
LLM4AD/